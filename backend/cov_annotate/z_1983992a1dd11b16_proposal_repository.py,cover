> import sqlite3
> import uuid
> from datetime import datetime, timezone
  
> from gysi_ml.persistence.database import get_connection
  
  
> def _row_to_dict(row: sqlite3.Row) -> dict:
>     return dict(row)
  
  
> def create_proposal(
>     session_id: str,
>     spec_json: str,
>     explanation: str,
>     db_path: str | None = None,
> ) -> dict:
>     """Legt einen neuen Proposal mit status='pending' an."""
>     proposal_id = str(uuid.uuid4())
>     created_at = datetime.now(timezone.utc).isoformat()
>     conn = get_connection(db_path)
>     try:
>         cursor = conn.cursor()
>         cursor.execute(
>             """
>             INSERT INTO proposals (proposal_id, session_id, spec_json, explanation, status, created_at)
>             VALUES (?, ?, ?, ?, ?, ?)
>             """,
>             (proposal_id, session_id, spec_json, explanation, "pending", created_at),
>         )
>         conn.commit()
>         cursor.execute(
>             "SELECT proposal_id, session_id, spec_json, explanation, status, created_at"
>             " FROM proposals WHERE proposal_id = ?",
>             (proposal_id,),
>         )
>         return _row_to_dict(cursor.fetchone())
>     finally:
>         conn.close()
  
  
> def get_pending_proposal(session_id: str, db_path: str | None = None) -> dict | None:
>     """Gibt den offenen (pending) Proposal einer Session zurück oder None."""
>     conn = get_connection(db_path)
>     try:
>         cursor = conn.cursor()
>         cursor.execute(
>             "SELECT proposal_id, session_id, spec_json, explanation, status, created_at"
>             " FROM proposals WHERE session_id = ? AND status = 'pending'",
>             (session_id,),
>         )
>         row = cursor.fetchone()
>         return _row_to_dict(row) if row else None
>     finally:
>         conn.close()
  
  
> def get_proposal(proposal_id: str, db_path: str | None = None) -> dict | None:
>     """Gibt einen Proposal anhand seiner ID zurück oder None."""
