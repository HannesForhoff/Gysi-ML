> _VALID_STATUSES = {"confirmed", "rejected"}
  
  
> def update_proposal_status(
>     proposal_id: str,
>     status: str,
>     db_path: str | None = None,
> ) -> None:
>     """Aktualisiert den Status eines Proposals (z.B. 'confirmed' oder 'rejected')."""
>     if status not in _VALID_STATUSES:
>         raise ValueError(f"Ungültiger Proposal-Status: {status!r} (erlaubt: {_VALID_STATUSES})")
>     conn = get_connection(db_path)
>     try:
>         cursor = conn.cursor()
>         cursor.execute(
>             "UPDATE proposals SET status = ? WHERE proposal_id = ?",
>             (status, proposal_id),
>         )
>         conn.commit()
>     finally:
>         conn.close()
  
  
> def reject_pending_proposals(session_id: str, db_path: str | None = None) -> int:
>     """Setzt alle pending Proposals einer Session auf 'rejected'.
  
>     Returns:
>         Anzahl der aktualisierten Rows.
>     """
>     conn = get_connection(db_path)
>     try:
>         cursor = conn.cursor()
>         cursor.execute(
>             "UPDATE proposals SET status = 'rejected' WHERE session_id = ? AND status = 'pending'",
>             (session_id,),
>         )
>         conn.commit()
>         return cursor.rowcount
>     finally:
>         conn.close()
