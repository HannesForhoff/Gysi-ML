> import pandas as pd
  
> from gysi_ml.steps.base import BaseStep
> from gysi_ml.steps.registry import register_step
  
  
> @register_step("dedup")
> class DeduplicationStep(BaseStep):
>     description = "Entfernt exakt duplizierte Zeilen aus dem Datensatz"
>     param_schema = {}
  
>     def __init__(self, params: dict | None = None) -> None:
>         super().__init__(params)
>         self._removed_duplicates: int = 0
  
>     def fit(self, df_train: pd.DataFrame) -> None:
>         pass
  
>     def transform(
>         self, df_train: pd.DataFrame, df_test: pd.DataFrame
>     ) -> tuple[pd.DataFrame, pd.DataFrame]:
>         deduped_train = df_train.drop_duplicates().reset_index(drop=True)
>         deduped_test = df_test.drop_duplicates().reset_index(drop=True)
>         self._removed_duplicates = (len(df_train) - len(deduped_train)) + (
>             len(df_test) - len(deduped_test)
>         )
>         return deduped_train, deduped_test
  
>     def get_metadata(self) -> dict:
>         return {"removed_duplicates": self._removed_duplicates}
